<Window
    x:Class="MailAssistant.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MailAssistant">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid Padding="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="16" VerticalAlignment="Top">
                <FontIcon Glyph="&#xE715;" FontSize="48" HorizontalAlignment="Left" />
                <TextBlock Text="MailAssistant für Windows" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="Die Grundlage steht. Konten und E-Mails folgen im nächsten Schritt."
                           TextWrapping="Wrap" MaxWidth="320" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                <TextBlock Text="Konten" Style="{StaticResource TitleTextBlockStyle}" />
                <ItemsControl x:Name="AccountsList" VerticalAlignment="Top">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="AccountCard"
                                Margin="0,0,0,8"
                                Padding="12"
                                CornerRadius="4"
                                BorderThickness="1"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                Tapped="OnAccountCardTapped"
                                HorizontalAlignment="Stretch">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="{Binding DisplayName}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock Text="{Binding EmailAddress}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Eingabemaske: optisch zur Konto-Card abgestimmtes Panel. -->
                <Border
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="16"
                    Margin="0,4,0,0">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Neues Konto hinzufügen" Style="{StaticResource BodyStrongTextBlockStyle}" />

                        <StackPanel Spacing="4">
                            <TextBlock Text="Anzeigename" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBox
                                x:Name="DisplayNameTextBox"
                                PlaceholderText="z. B. Arbeit"
                                VerticalAlignment="Top" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="E-Mail-Adresse" Style="{StaticResource BodyTextBlockStyle}" />
                            <TextBox
                                x:Name="EmailAddressTextBox"
                                PlaceholderText="vorname@beispiel.de"
                                VerticalAlignment="Top" />
                        </StackPanel>

                        <Button
                            x:Name="AccountAddedButton"
                            Content="Konto hinzufügen"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center" />

                        <StackPanel
                            Spacing="6"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Stretch">
                            <Border
                                Height="1"
                                Background="{ThemeResource CardStrokeColorDefaultBrush}"
                                Margin="0,0,0,4" />
                            <Button
                                x:Name="AccountRemoveButton"
                                Content="Konto entfernen"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                IsEnabled="False"
                                Foreground="{ThemeResource CardStrokeColorDefaultBrush}"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                Click="OnAccountRemoveButtonClick" />
                        </StackPanel>

                        <TextBlock
                            x:Name="StatusText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap"
                            MaxWidth="360"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
